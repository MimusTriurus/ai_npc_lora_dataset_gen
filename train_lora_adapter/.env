STEP_0_MODEL_NAME=Qwen3-4B-Instruct-2507
# Qwen/Qwen3-Embedding-0.6B | Qwen/Qwen3-Embedding-4B | BAAI/bge-base-en-v1.5
STEP_0_EMB_MODEL_NAME="BAAI/bge-base-en-v1.5"

STEP_0_DATASET_SIZE=4000
STEP_0_NUM_TRAIN_EPOCH=4
STEP_0_LORA_RANK=4
STEP_0_LORA_ALPHA=128
STEP_0_USE_EVAL=false
STEP_0_VALIDATION_SPLIT=0.05
STEP_0_BATCH_SIZE=2
#
# реалистичный горизонт: warmup_ratio+cosine укладываются в фактическую длительность.
# 128 эпох ломали расписание LR (весь прогон шёл в warmup, спад не включался).
STEP_0_EMB_NUM_TRAIN_EPOCH=10
# steps | no  (LLM step_0_train)
STEP_0_EVAL_STRATEGY=steps
STEP_0_EVAL_STEPS=200
#
# --- embedding LoRA step (step_0_train_embedding) ---
# LoRA-scale LR (full-FT uses ~2e-5; adapters need higher)
STEP_0E_LEARNING_RATE=2e-4
# Фикс. длина warmup в шагах (>0 имеет приоритет над warmup_ratio).
# Надёжно при "эпохи с запасом + early stopping": LR не зависит от горизонта.
STEP_0E_WARMUP_STEPS=100
# eval по шагам -> рабочий early stopping + load_best_model_at_end
STEP_0E_EVAL_STRATEGY=steps
STEP_0E_EVAL_STEPS=50
# batch size эмбеддинг-LoRA (16 ГБ VRAM, bge-base)
STEP_0E_BATCH_SIZE=64
STEP_0E_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# mnr\cosent
STEP_0E_LOSS="cosent"
# user_request\action_signature
STEP_0_SENTENCE2_MODE="action_signature"

# convert to gguf
STEP_1_LLAMA_BIN_DIR=D:/Projects/C++/llama.cpp/cmake-build-release-visual-studio/bin
STEP_1_LLAMA_CPP_DIR=D:/Projects/C++/llama.cpp/

# validation
STEP_2_MAX_REQUESTS_COUNT=100
STEP_2_USE_THINKING=false
STEP_2_LLM_CFG_F_PATH=resources/ullama_cfg.json
STEP_2_EMB_THRESHOLD=0.4
STEP_2_TOP_K=2

S3_SECRET_KEY=minioadmin
S3_ACCESS_KEY=minioadmin
S3_ENDPOINT=127.0.0.1:9000
S3_IS_SECURE=false
# LORA dataset type: chat | tool_calling
DATASET_NAME="chat"

# bge e0fd910 # qwen c1c00eb
LLM_TRAINING_SESSION_HASH="1a48312"
EMB_TRAINING_SESSION_HASH="f2e08a7"

# starting parameters
COMMIT="7c01ee7"
NPC_NAME="trader"
FLOW_RUN_ID="v2"

ACTIONS_BLACK_LIST="NotEnoughGoldToBuy,OutOfStock,DoNothing"
